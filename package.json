{
  "name": "prediction-radar",
  "version": "0.1.0",
  "description": "Personal Polymarket signal detection system focused on AI and Big Tech markets",
  "keywords": [
    "polymarket",
    "prediction-markets",
    "trading",
    "ai",
    "automation"
  ],
  "license": "MIT",
  "author": "Luiz Oliveira",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "test:db": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,mailpit,realtime,storage-api && RADAR_TEST_DB=required npm test",
    "test:db:stop": "supabase stop --no-backup",
    "bot": "tsx src/bot/index.ts",
    "eval:analyst": "tsx scripts/eval-analyst.ts",
    "eval:market": "tsx scripts/eval-market-calibration.ts",
    "backtest:favorite": "tsx scripts/backtest-favorite.ts",
    "backfill:neg-risk": "tsx scripts/backfill-neg-risk-ids.ts",
    "relacoes:coletar": "tsx scripts/coletar-grupos-resolvidos.ts",
    "relacoes:extrair": "tsx scripts/extrair-relacoes.ts",
    "relacoes:medir": "tsx scripts/medir-relacoes.ts",
    "backfill:polymarket-category": "tsx scripts/backfill-polymarket-category.ts",
    "backfill:game-start-time": "tsx scripts/backfill-game-start-time.ts",
    "backfill:esports-matches": "tsx scripts/backfill-esports-matches.ts",
    "backfill:match-outcomes": "tsx scripts/backfill-match-outcomes.ts",
    "backfill:texto-da-regra": "tsx scripts/backfill-texto-da-regra.ts",
    "live:reversion": "tsx scripts/probe-live-reversion.ts",
    "liquipedia:probe": "tsx scripts/probe-liquipedia.ts",
    "oddspapi:probe": "tsx scripts/probe-oddspapi.ts",
    "polymarket:universe": "tsx scripts/probe-polymarket-universe.ts",
    "digerir": "tsx scripts/digerir-regras.ts",
    "carregar-digest": "tsx scripts/carregar-digest.ts",
    "medir-consistencia": "tsx scripts/medir-consistencia.ts",
    "medir:tela-regra": "tsx scripts/medicoes/tela-regra.ts",
    "medir:idioma": "tsx scripts/medicoes/idioma.ts",
    "medir:texto-perdido": "tsx scripts/medicoes/texto-perdido.ts",
    "medir:digest-nulo": "tsx scripts/medicoes/digest-nulo.ts",
    "medir:serie": "tsx scripts/medicoes/serie-prob-self.ts",
    "nivelar": "tsx scripts/nivelar-leituras.ts",
    "radar:lista": "tsx scripts/montar-lista-radar.ts",
    "radar:coletor": "tsx scripts/radar-coletor.ts",
    "radar:categorias": "tsx scripts/radar-categorias.ts",
    "radar:conferir": "tsx scripts/conferir-views.ts",
    "leadlag:spread": "tsx scripts/probe-lead-lag-spread.ts",
    "compostos": "tsx scripts/probe-mercados-compostos.ts",
    "xtracker:probe": "tsx scripts/probe-xtracker.ts",
    "xtracker:calib": "tsx scripts/probe-xtracker-calibration.ts",
    "xtracker:reanalyze": "tsx scripts/analyze-xtracker-calibration.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.14",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@grammyjs/conversations": "^2.1.1",
    "@supabase/supabase-js": "^2.105.1",
    "dotenv": "^17.4.2",
    "grammy": "^1.42.0",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^2.1.0",
    "tsx": "^4.21.0"
  }
}
