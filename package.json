{
  "name": "prediction-radar",
  "version": "0.1.0",
  "description": "Personal Polymarket signal detection system focused on AI and Big Tech markets",
  "keywords": [
    "polymarket",
    "prediction-markets",
    "trading",
    "ai",
    "automation"
  ],
  "license": "MIT",
  "author": "Luiz Oliveira",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint src scripts experiments",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm run typecheck --prefix web",
    "build:web": "npm run build --prefix web",
    "conferir:bundle": "tsx scripts/conferir-bundle-web.ts web/.next/static web/.next/server/app",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"web/src/**/*.test.ts\" \"experiments/**/*.test.ts\"",
    "test:db": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,mailpit,realtime,storage-api && RADAR_TEST_DB=required tsx --test --test-concurrency=1 \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"web/src/**/*.test.ts\" \"experiments/**/*.test.ts\"",
    "test:db:stop": "supabase stop --no-backup",
    "arquivar:particao": "tsx scripts/arquivar-particao.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run typecheck:web && npm run build:web",
    "bot": "tsx src/bot/index.ts",
    "eval:analyst": "tsx scripts/eval-analyst.ts",
    "backfill:texto-da-regra": "tsx scripts/backfill-texto-da-regra.ts",
    "digerir": "tsx scripts/digerir-regras.ts",
    "carregar-digest": "tsx scripts/carregar-digest.ts",
    "medir-consistencia": "tsx scripts/medir-consistencia.ts",
    "medir:tela-regra": "tsx scripts/medicoes/tela-regra.ts",
    "medir:idioma": "tsx scripts/medicoes/idioma.ts",
    "medir:texto-perdido": "tsx scripts/medicoes/texto-perdido.ts",
    "medir:digest-nulo": "tsx scripts/medicoes/digest-nulo.ts",
    "medir:serie": "tsx scripts/medicoes/serie-prob-self.ts",
    "medir:haiku": "tsx scripts/medicoes/haiku-vs-deepseek.ts",
    "nivelar": "tsx scripts/nivelar-leituras.ts",
    "radar:lista": "tsx scripts/montar-lista-radar.ts",
    "radar:coletor": "tsx scripts/radar-coletor.ts",
    "radar:categorias": "tsx scripts/radar-categorias.ts",
    "radar:conferir": "tsx scripts/conferir-views.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "esbuild": "0.27.7",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@aws-sdk/client-dynamodb": "3.1161.0",
    "@aws-sdk/client-ssm": "3.1161.0",
    "@aws-sdk/lib-dynamodb": "3.1161.0",
    "@grammyjs/conversations": "^2.1.1",
    "@supabase/supabase-js": "^2.105.1",
    "dotenv": "^17.4.2",
    "grammy": "^1.42.0",
    "node-cron": "^4.2.1",
    "tsx": "^4.21.0"
  }
}
