{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(src/**)",
      "Write(src/**)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Write(probes/**)",
      "Edit(specs/**)",
      "Write(specs/**)",
      "Write(supabase/migrations/**)",
      "Edit(*.md)",
      "Write(*.md)"
    ],
    "deny": [
      "Bash(supabase db push*)",
      "Bash(supabase db reset*)",
      "Bash(supabase db pull*)",
      "Bash(supabase migration up*)",
      "Bash(psql*)",
      "Bash(git push*)",
      "Bash(npm run oddspapi:probe*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "defaultMode": "acceptEdits"
  }
}