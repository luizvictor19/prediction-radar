{
  "permissions": {
    "allow": [
      "Bash(*)",
      "EnterWorktree",
      "ExitWorktree",
      "Edit(src/**)",
      "Write(src/**)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Write(probes/**)",
      "Edit(specs/**)",
      "Write(specs/**)",
      "Write(supabase/migrations/**)",
      "Edit(*.md)",
      "Write(*.md)"
    ],
    "deny": [
      "Bash(supabase db push*)",
      "Bash(supabase db reset*)",
      "Bash(supabase db pull*)",
      "Bash(supabase migration up*)",
      "Bash(psql*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf*)",
      "Bash(npm run oddspapi:probe*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-commit-on-main.sh"
          }
        ]
      }
    ]
  }
}
